# Copy this file to .env.local and fill in your local validator LLM settings.
# Never put these values in cli-frontend/.env because VITE_* variables are exposed to the browser.

VALIDATOR_LLM_SCRIPT=/Users/twh/Projects/Agent Nexus/validator-llms/deepseek-dispute/run.py
VALIDATOR_LLM_API_KEY=replace-with-your-real-validator-llm-key
# VALIDATOR_LLM_TIMEOUT=60s
# VALIDATOR_LLM_MODEL=deepseek-chat
# VALIDATOR_LLM_BASE_URL=https://api.deepseek.com/chat/completions

# Optional local validator overrides.
# VALIDATOR_RPC_URL=http://localhost:8545
# VALIDATOR_BASE_URL=http://localhost:8082
# VALIDATOR_HTTP_ADDR=:8082
# VALIDATOR_DB_PATH=./validator-service.db

# Default Anvil validator private key used by scripts/seed-demo.sh.
# Override this only if you start the local chain with a different validator account.
# VALIDATOR_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
