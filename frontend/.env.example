# 链 RPC 端点（只读，无需私钥）
VITE_RPC_URL=http://localhost:8545
# 当前 Market 合约地址
VITE_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
# validator-service 地址（提供“我的判决流程”私有数据）
VITE_VALIDATOR_API_BASE_URL=http://localhost:8082
# 可选：演示时默认“以某验证者身份查看”（留空则用后端 /me 的地址）
VITE_DEFAULT_VIEW_AS=
# 可选：自动刷新间隔(ms)，0 表示关闭轮询
VITE_POLL_MS=15000
